# Copy this file to a private environment file if needed. Do not commit secrets.

US_RADAR_SEC_USER_AGENT="zhulong-us-radar/0.1 your_email@example.com"
US_RADAR_SKIP_NETWORK=0
US_RADAR_SEC_LIMIT=25
US_RADAR_REPORT_HOURS=24

# Safety boundary: require Zhulong's read-only snapshot for CN prices.
# Set to 0 only for an explicit, temporary readonly-live-DB recovery action.
US_RADAR_REQUIRE_SNAPSHOT=1

# Optional sidecar-only proxy. These are exported only inside 10_us_radar scripts.
US_RADAR_HTTP_PROXY=""
US_RADAR_HTTPS_PROXY=""
US_RADAR_ALL_PROXY=""
US_RADAR_NO_PROXY=""

# Optional LLM providers for Phase 2.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
US_RADAR_LLM_PROVIDER="dry_run"
US_RADAR_LLM_MODEL="dry-run-evidence-v0"

# Optional push channels.
US_RADAR_PUSH_SEND=0
US_RADAR_PUSH_HOURS=24
US_RADAR_PUSH_LIMIT=5
# Optional: if empty, push-daily --send can reuse the main PUSHPLUS_TOKEN.
US_RADAR_PUSHPLUS_TOKEN=""
US_RADAR_TELEGRAM_BOT_TOKEN=""
US_RADAR_TELEGRAM_CHAT_ID=""
US_RADAR_SERVERCHAN_SENDKEY=""
US_RADAR_BARK_URL=""

# Optional paid data providers.
# Set to 1 when FMP is unavailable so US prices go directly to yfinance/Alpha Vantage fallback.
US_RADAR_DISABLE_FMP=0
US_RADAR_POLYGON_API_KEY=""
US_RADAR_FMP_API_KEY=""
US_RADAR_ALPHA_VANTAGE_API_KEY=""

# Emergency historical-price fallback after yfinance and Alpha Vantage.
# The client enforces an upper bound of 7 calls/minute even if configured higher.
US_RADAR_TWELVE_DATA_API_KEY=""
US_RADAR_TWELVE_MAX_CALLS_PER_MINUTE=7
US_RADAR_TWELVE_CACHE_TTL_SECONDS=43200

# Read-only shadow comparison providers. They are not in the automatic fallback
# chain until their adjusted daily bars pass the observation acceptance gate.
US_RADAR_ALPACA_API_KEY=""
US_RADAR_ALPACA_SECRET_KEY=""
US_RADAR_MASSIVE_API_KEY=""

# Reserved for quote/profile enrichment; not used for historical validation.
US_RADAR_FINNHUB_API_KEY=""
