[Unit]
Description=Zhulong Watchtower API (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/quant_project
ExecStart=/usr/bin/python3 /root/quant_project/06_watchtower/api_server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
