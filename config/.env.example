# Zhulong public configuration template
# Copy to config/.env and provide private values locally.
# Never commit config/.env or any real credential.

ZHULONG_DB_PATH=/root/quant_project/storage/database/zhulong.duckdb

# Market data and notifications
TUSHARE_TOKEN=
PUSHPLUS_TOKEN=

# Local model services. 192.0.2.0/24 is documentation-only.
OLLAMA_BASE_URL=http://192.0.2.20:11434
RAG_OLLAMA_BASE_URL=http://192.0.2.20:11434
OLLAMA_PRIMARY_BASE_URL=http://192.0.2.20:11434
OLLAMA_BACKUP_BASE_URL=http://192.0.2.21:11434
OPENVINO_SHADOW_HOST=root@192.0.2.20

# Deterministic L2/L3 remain authoritative.
L2_MODEL_ENABLED=0
L3_MODEL_ENABLED=1
L3_MODEL_AUTHORITY_ENABLED=0

# Mandatory L4 providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
KIMI_API_KEY=
QWEN_API_KEY=

# A failed mandatory L4 call pauses the audit and retries every 30 minutes.
L4_PROVIDER_RECOVERY_POLL_SECONDS=1800

# News collection stays separate from L4 prompt authority.
L4_NEWS_ENABLED=1
L4_NEWS_POLICY=OBSERVE_ONLY

# Intraday candidate discovery is observation-only by default.
EAGLE_ACTIVE_PATH_ENABLED=0

# Manual, bounded web-evidence probes. Empty means disabled.
ANYSEARCH_API_KEY=
FIRECRAWL_API_KEY=

# Required for sensitive Watchtower routes.
WATCHTOWER_TOUCHSTONE_KEY=
# Comma-separated browser origins. Never use '*' on an Internet-reachable deployment.
WATCHTOWER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
